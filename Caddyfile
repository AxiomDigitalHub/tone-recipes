# Origin config for faderandknob.com behind Cloudflare (orange-cloud proxy).
# Caddy auto-provisions Let's Encrypt certificates; Cloudflare SSL/TLS mode
# is "Full (strict)".
#
# www → apex is redirected HERE (not just in middleware): behind the proxy
# the app's request.url carries the internal :3000 port, so the middleware
# redirect leaked it. Caddy knows the real public origin.

www.faderandknob.com {
	redir https://faderandknob.com{uri} permanent
}

faderandknob.com {
	encode zstd gzip
	reverse_proxy app:3000
}
